# Copy to .env and adjust for your machine. docker compose reads .env automatically.
#
# Host path for the judge workspace (bind-mounted into the backend container at
# the identical path). On a standard Docker install the default /tmp/judge-workspace
# is fine; on snap-packaged Docker the source must be under your home directory.
JUDGE_WORKSPACE_HOST=/tmp/judge-workspace
#
# Change this to a long random value for any non-local deployment.
JWT_SECRET=local-dev-secret-change-in-production-please-min-32-chars
