// System architecture (portrait, compact so text stays large at \textwidth).
// Render: dot -Tpng -Gdpi=300 architecture.dot -o ../images/architecture.png
digraph architecture {
  rankdir=TB;
  bgcolor="white";
  graph [fontname="Helvetica", fontsize=17, nodesep=0.35, ranksep=0.5];
  node  [fontname="Helvetica", fontsize=16, shape=box, style="rounded,filled", fillcolor="white", color="black", margin="0.16,0.10"];
  edge  [fontname="Helvetica", fontsize=14, color="black"];

  client [label="Browser\n(React SPA, Monaco)"];
  nginx  [label="nginx  :3000"];

  subgraph cluster_backend {
    label="Spring Boot backend  :8080";
    style="rounded,filled"; fillcolor="gray95"; color="black"; fontsize=17;
    security    [label="Security\n(JwtAuthFilter,\nSecurityConfig)"];
    controllers [label="Controllers"];
    services    [label="Services"];
    judge       [label="Judge\n(JudgeService @Async,\nJudgePersistence,\nContainerRunner)"];
    repos       [label="Repositories (JPA)"];

    security -> controllers [label="auth"];
    controllers -> services -> judge;
    services -> repos;
    judge -> repos;
    { rank=same; security; controllers; }
  }

  postgres [label="PostgreSQL\n(source of truth)", shape=cylinder];
  redis    [label="Redis\n(leaderboard)", shape=cylinder];

  subgraph cluster_sandbox {
    label="Host Docker daemon";
    style="rounded,filled"; fillcolor="gray95"; color="black"; fontsize=17;
    daemon  [label="docker run\n(per compile / test)"];
    runners [label="judge-runner images\n(cpp / java / python):\nnetwork=none, resource\ncaps, non-root"];
    daemon -> runners;
  }

  client -> nginx -> controllers [label="/api (JWT)"];
  repos  -> postgres;
  judge  -> redis [label="ZINCRBY /\nZREVRANGE"];
  judge  -> daemon [label="launches\nsandboxes"];
  { rank=same; repos; redis; }
  { rank=same; postgres; daemon; }
}
