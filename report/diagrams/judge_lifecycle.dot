// Submission lifecycle, from Submit click to verdict (compact vertical flow).
// Render: dot -Tpng -Gdpi=300 judge_lifecycle.dot -o ../images/judge_lifecycle.png
digraph lifecycle {
  rankdir=TB;
  bgcolor="white";
  graph [fontname="Helvetica", fontsize=17, nodesep=0.35, ranksep=0.4];
  node  [fontname="Helvetica", fontsize=16, shape=box, style="rounded,filled", fillcolor="white", color="black", margin="0.18,0.11"];
  edge  [fontname="Helvetica", fontsize=14, color="black"];

  s1 [label="ProblemDetail.jsx:  POST /api/submissions"];
  s2 [label="JwtAuthFilter: validate token, set user"];
  s3 [label="SubmissionController.submit\n@Valid (source <= 64 KB)"];
  s4 [label="SubmissionService.submit: rate-limit (429),\nsave PENDING, fire judgeAsync(); returns at once"];
  s5 [label="JudgePersistence.beginJudging  [short tx]\nmark RUNNING, load source + test cases"];
  s6 [label="JudgeService  (@Async, no tx held)\nwrite source to workspace"];
  s7 [label="ContainerRunner.run (compile step)\nC++/Java compile, Python py_compile"];
  s8 [label="compile failed:\nrecordCompileError\n[short tx], stop", fillcolor="gray92"];
  s9 [label="ContainerRunner.run: one sandbox per test case\n(stdout/stderr capped at 64 KB)"];
  s10 [label="JudgeService.mapVerdict\nTLE / OLE / MLE / RE / AC / WA"];
  s11 [label="JudgePersistence.saveResults  [short tx]\nper-test rows, verdict, score, UserProgress"];
  s12 [label="first solve: LeaderboardService.onFirstSolve\nRedis ZINCRBY (outside tx)"];
  s13 [label="SubmissionStatus.jsx: poll until terminal"];

  s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7;
  s7 -> s8 [label="non-zero exit"];
  s7 -> s9 [label="ok"];
  s9 -> s10 -> s11 -> s12 -> s13;
}
