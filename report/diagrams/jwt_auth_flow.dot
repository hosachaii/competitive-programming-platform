// JWT access + refresh token flow: three phases as clean side-by-side columns
// with bold header labels. Render: dot -Tpng -Gdpi=300 jwt_auth_flow.dot -o ../images/jwt_auth_flow.png
digraph jwt {
  rankdir=TB;
  bgcolor="white";
  graph [fontname="Helvetica", fontsize=15, nodesep=0.5, ranksep=0.45];
  node  [fontname="Helvetica", fontsize=14, shape=box, style="rounded,filled", fillcolor="white", color="black", margin="0.16,0.11"];
  edge  [fontname="Helvetica", fontsize=12, color="black"];

  h1 [label="1.  Login / Register",        shape=plaintext, fillcolor="none", fontname="Helvetica-Bold", fontsize=16];
  h2 [label="2.  Authenticated request",   shape=plaintext, fillcolor="none", fontname="Helvetica-Bold", fontsize=16];
  h3 [label="3.  Access token expired",    shape=plaintext, fillcolor="none", fontname="Helvetica-Bold", fontsize=16];

  l1 [label="Login page posts\nemail + password\nto /api/auth/login"];
  l2 [label="AuthService authenticates\nvia AuthenticationManager\n(BCrypt check)"];
  l3 [label="JwtService issues two\nHMAC-signed tokens:\naccess (15 min),\nrefresh (7 days)"];
  l4 [label="Browser stores both\ntokens in localStorage"];

  r1 [label="axios attaches\nAuthorization:\nBearer <access>"];
  r2 [label="JwtAuthFilter verifies\nsignature + expiry,\nsets SecurityContext"];
  r3 [label="Controller runs;\nroles enforced by\nSecurityConfig"];

  f1 [label="API returns 401"];
  f2 [label="axios interceptor posts\nrefresh token to\n/api/auth/refresh"];
  f3 [label="AuthService.refresh\nvalidates type=refresh,\nissues new access token"];
  f4 [label="Original request\nretried once"];

  h1 -> l1 [style=invis];
  h2 -> r1 [style=invis];
  h3 -> f1 [style=invis];
  l1 -> l2 -> l3 -> l4;
  r1 -> r2 -> r3;
  f1 -> f2 -> f3 -> f4;

  { rank=same; h1; h2; h3; }
  { rank=same; l1; r1; f1; }
  { rank=same; l2; r2; f2; }
  { rank=same; l3; r3; f3; }
  { rank=same; l4; f4; }
  h1 -> h2 [style=invis]; h2 -> h3 [style=invis];
  l1 -> r1 [style=invis]; r1 -> f1 [style=invis];
  l2 -> r2 [style=invis]; r2 -> f2 [style=invis];
  l3 -> r3 [style=invis]; r3 -> f3 [style=invis];
}
